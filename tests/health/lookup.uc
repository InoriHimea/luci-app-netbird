import { lookup_path, parse_lookup } from '../../luci-app-netbird/root/usr/share/netbird/health/lookup.uc';
let n = 0;
function check(ok, label) { if (!ok) die(`FAIL: ${label}\n`); printf('ok %d - %s\n', ++n, label); }
let path = { approval: { approved: true }, source_ip: '192.0.2.10', destination: '10.40.1.2', ingress_interface: 'br-lan' };
let valid = '[{"dst":"10.40.1.2","from":"192.0.2.10","dev":"mesh-alt","table":9911,"flags":[]}]';
let p = parse_lookup(valid, 'json', path);
check(p.ok && p.table == '9911' && p.source == path.source_ip, 'kernel table and query source preserved');
check(parse_lookup('[{"dst":"10.40.1.2","dev":"mesh-alt"}]', 'json', path).reason == 'LOOKUP_TABLE_UNAVAILABLE', 'missing kernel table never inferred from static routes');
check(!parse_lookup('[{"dst":"10.40.1.2","from":"192.0.2.99","dev":"mesh-alt","table":9911}]', 'json', path).ok, 'foreign source rejected');
check(!parse_lookup('[{"dst":"10.40.1.2","dev":"mesh-alt","table":9911,"nhid":3}]', 'json', path).ok, 'unknown forwarding semantics rejected');
check(!parse_lookup('[]', 'json', path).ok && !parse_lookup('[', 'json', path).ok, 'empty and truncated outputs rejected');
p = parse_lookup('10.40.1.2 from 192.0.2.10 dev mesh-alt table 9911\n cache', 'text', path);
check(p.ok && p.table == '9911', 'text fallback preserves explicit table');
check(!parse_lookup('10.40.1.2 dev mesh-alt table 9911 dev wan', 'text', path).ok, 'duplicate egress rejected');
let calls = 0;
p = lookup_path(path, (argv) => { calls++; return { ok: false, reason: 'COMMAND_TIMEOUT' }; }, '/sbin/ip');
check(!p.ok && calls == 1, 'timeout does not authorize fallback');
calls = 0;
p = lookup_path(path, (argv) => {
    calls++;
    if (calls == 1) return { ok: false, json_unsupported: true };
    check(sprintf('%J', argv) == sprintf('%J', ['/sbin/ip', '-d', '-4', 'route', 'get', path.destination, 'from', path.source_ip, 'iif', 'br-lan']), 'forwarded query retains source and ingress');
    return { ok: true, stdout: '10.40.1.2 from 192.0.2.10 dev mesh-alt table 9911' };
}, '/sbin/ip');
check(p.ok && calls == 2, 'recognized JSON capability failure permits bounded text query');
path.optional_mark = 16; calls = 0;
p = lookup_path(path, () => { calls++; }, '/sbin/ip');
check(p.reason == 'MARK_PROVENANCE_UNVERIFIED' && calls == 0, 'unverified mark never enters kernel query');
path.routing = { mark_reference: { priority: 77, table: '9911', mark: 16, mask: 255 } };
let rules = { ok: true, records: [{ priority: 77, table: '9911', fwmark: '0x10', fwmask: '0xff' }] };
p = lookup_path(path, (argv) => { calls++; return { ok: true, stdout: valid }; }, '/sbin/ip', rules);
check(p.ok && calls == 1, 'approved mark reference resolved against observed rule');
calls = 0; rules.records[0].fwmark = '0x20';
p = lookup_path(path, () => { calls++; }, '/sbin/ip', rules);
check(p.reason == 'MARK_PROVENANCE_UNVERIFIED' && calls == 0, 'changed mark rule prevents query');
rules.records[0].fwmark = '0x10'; push(rules.records, rules.records[0]);
p = lookup_path(path, () => { calls++; }, '/sbin/ip', rules);
check(p.reason == 'MARK_PROVENANCE_UNVERIFIED' && calls == 0, 'ambiguous rule reference prevents marked query');
let marked = json(valid); marked[0].mark = '0x10';
check(parse_lookup(sprintf('%J', marked), 'json', path).ok, 'hexadecimal kernel mark retains numeric value');
marked[0].mark = null;
check(!parse_lookup(sprintf('%J', marked), 'json', path).ok, 'explicit null mark is not missing evidence');
marked[0].mark = 16; marked[0].from = null;
check(!parse_lookup(sprintf('%J', marked), 'json', path).ok, 'explicit null source cannot bypass binding');
path.optional_mark = null; path.approval.approved = false;
p = lookup_path(path, () => { calls++; }, '/sbin/ip');
check(p.reason == 'INTENT_UNVERIFIED' && calls == 0, 'unapproved intent never enters kernel query');
printf('PASS: %d lookup assertions\n', n);
