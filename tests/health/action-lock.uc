import { mkdtemp, mkdir, readfile, writefile, unlink, popen } from 'fs';
import { atomic_json } from '../../luci-app-netbird/root/usr/share/netbird/health/storage.uc';
const factory = loadfile('./luci-app-netbird/root/usr/share/rpcd/ucode/lib/action_lock.uc')();
let count = 0;
function check(value, message) { if (!value) die(message); count++; }
let root = mkdtemp('/tmp/nbh-action-lock.XXXXXX');
for (let name in ['/tmp', '/proc', '/proc/self', '/proc/sys', '/proc/sys/kernel', '/proc/sys/kernel/random'])
    check(mkdir(root + name, 0700), 'create isolated process view');
let process = readfile('/proc/self/stat'), pid = match(process, /^([0-9]+)/)[1];
check(mkdir(root + '/proc/' + pid, 0700), 'create current owner view');
writefile(root + '/proc/self/stat', process);
writefile(root + '/proc/' + pid + '/stat', process);
let boot = trim(readfile('/proc/sys/kernel/random/boot_id'));
writefile(root + '/proc/sys/kernel/random/boot_id', boot);
let now = 10000, first = factory.create(root, () => now), second = factory.create(root, () => now);
check(first.acquire('manual-recovery').ok, 'one action owns exclusion');
check(second.acquire('watchdog').reason == 'ACTION_BUSY', 'simultaneous watchdog action rejected');
check(first.release(), 'owner releases exact marker');
check(second.acquire('settings').ok && second.release(), 'settings can proceed after completed action');
function orphan(owner, started, saved_boot) {
    let dir = root + '/tmp/nb-binop.lock';
    check(mkdir(dir, 0700), 'create interrupted owner marker');
    writefile(dir + '/owner', owner + '\n');
    check(atomic_json(dir, 'identity.json', { schema_version: 1, id: '0123456789abcdef0123456789abcdef',
        owner: 'manual-recovery', pid: owner, started, boot_id: saved_boot }, 2048), 'publish interrupted owner identity');
}
orphan('999999', '1', boot);
check(second.acquire('watchdog').reason == 'ACTION_DRAIN_PENDING', 'dead parent does not imply stopped children');
let fence_started = now;
now += 599999;
check(second.acquire('watchdog').reason == 'ACTION_DRAIN_PENDING', 'orphan drain fence remains until its full deadline');
now = fence_started - 1;
check(second.acquire('watchdog').reason == 'ACTION_DRAIN_PENDING', 'clock reversal cannot bypass orphan drain');
now = fence_started + 600000;
check(second.acquire('watchdog').ok && second.release(), 'expired bounded orphan fence cannot deadlock later actions');
orphan(pid, '0', boot);
check(!second.available(), 'reused live PID does not impersonate original owner');
now += 600000;
check(second.acquire('manual-recovery').ok && second.release(), 'PID reuse is reclaimable after drain fence');
orphan(pid, '0', '00000000-0000-0000-0000-000000000000');
check(second.acquire('settings').ok && second.release(), 'previous boot marker cannot fence the new boot');
let marker = root + '/tmp/nb-binop.lock';
mkdir(marker, 0755); writefile(marker + '/owner', '999999\n');
check(second.acquire('watchdog').reason == 'ACTION_DRAIN_PENDING', 'legacy 0755 owner marker enters bounded quarantine');
now += 600000;
check(second.acquire('watchdog').ok && second.release(), 'legacy orphan cannot remain permanently locked by private storage validation');
mkdir(marker, 0755); writefile(marker + '/owner', '999999\n');
writefile(marker + '/user-data', 'preserve');
check(second.acquire('manual-recovery').reason == 'ACTION_OWNER_CONFLICT', 'unrecognized external marker data blocks adoption');
check(readfile(marker + '/user-data') == 'preserve', 'external marker contents preserved');
check(second.acquire_recovery({ pid: '999999', start: '1', boot, group: '999999', session: '999999' }).reason == 'ACTION_OWNER_CONFLICT', 'critical rollback cannot delete unbound external marker data');
unlink(marker + '/user-data'); unlink(marker + '/owner');
// Recognized stale legacy content can now drain and retire normally.
writefile(marker + '/owner', '999999\n');
check(!second.available(), 'maintenance probe initializes orphan retirement without admitting an action');
now += 600000;
check(second.acquire('settings').ok && second.release(), 'maintenance-probed orphan eventually retires');
let prearmed = first.acquire('manual-recovery');
check(prearmed.ok && first.prepare_command(prearmed.id), 'pre-arm command before any side effect');
check(!first.release(), 'interrupted pre-exec command preserves recoverable owner state');
check(!first.publish_command(prearmed.id, pid), 'released owner cannot authorize a delayed command');
check(second.acquire('watchdog').reason == 'ACTION_DRAIN_PENDING', 'unpublished command enters bounded orphan quarantine');
let prepared_at = now;
now -= 1;
check(!second.acquire('watchdog').ok, 'clock reversal cannot retire pre-exec state');
now = prepared_at + 600000;
let replacement = second.acquire('settings');
check(replacement.ok && second.prepare_command(replacement.id), 'pre-exec crash does not permanently block later actions');
check(!first.publish_command(prearmed.id, pid) && !first.finish_command(prearmed.id), 'stale publisher cannot execute or clear new owner state');
check(second.finish_command(replacement.id) && second.release(), 'stale publisher leaves replacement owner able to complete');
let child = popen('/bin/busybox setsid /bin/sh -c \'echo $$; exec sleep 30\'', 'r');
let group = trim(child.read('line'));
if (!match(group, /^[1-9][0-9]*$/) || int(group) <= 1) die('native writer fixture failed to start');
let writer = first.acquire('manual-recovery');
check(writer.ok && first.prepare_command(writer.id) && first.publish_command(writer.id, group), 'bind command group before execution');
check(!first.release(), 'owner exit does not discard a potentially live writer');
now += 1200000;
check(second.acquire('watchdog').reason == 'ACTION_DRAIN_UNCONFIRMED', 'elapsed fence cannot authorize overlap with a live group');
system(['/bin/busybox', 'kill', '-9', '-' + group], 100);
child.close();
check(second.acquire('watchdog').reason == 'ACTION_DRAIN_PENDING', 'observed writer exit begins bounded orphan retirement');
now += 600000;
check(second.acquire('settings').ok && second.release(), 'drained group and expired quarantine release exclusion');
let late = first.acquire('manual-recovery');
check(late.ok && first.prepare_command(late.id) && !first.release(), 'unknown drain leaves explicit released owner');
check(first.finish_command(late.id), 'late confirmed cleanup can clear only its own command fence');
check(second.acquire('settings').reason == 'ACTION_DRAIN_PENDING', 'late cleanup does not revive released live PID ownership');
now += 600000;
check(second.acquire('settings').ok && second.release(), 'late cleanup cannot permanently fence a still-running RPC process');
let recovery_owner = { pid: '999999', start: '1', boot, group: '999999', session: '999999' };
orphan('999999', '1', boot);
check(!second.acquire_recovery({ pid: '999999', start: '2', boot, group: '999999', session: '999999' }).ok, 'rollback proof must bind the exact process start');
check(second.acquire_recovery(recovery_owner).ok && second.release(), 'drained exact transaction owner does not add another 600-second recovery delay');
let actual_start = split(match(process, /^[0-9]+ \(.*\) (.+)$/)[1], ' ')[19];
orphan(pid, actual_start, boot);
check(second.acquire_recovery({ pid, start: actual_start, boot, group: pid, session: pid }).reason == 'ACTION_BUSY', 'rollback cannot retire a still-live transaction owner');
unlink(root + '/proc/' + pid + '/stat');
check(second.acquire_recovery({ pid, start: actual_start, boot, group: pid, session: pid }).ok && second.release(), 'confirmed owner disappearance permits transaction-bound recovery');
child = popen('/bin/busybox setsid /bin/sh -c \'echo $$; exec sleep 30\'', 'r');
group = trim(child.read('line'));
orphan('999999', '1', boot);
check(atomic_json(marker, 'drain.json', { id: '0123456789abcdef0123456789abcdef', group }, 2048), 'publish real remaining command group');
check(second.acquire_recovery(recovery_owner).reason == 'ACTION_DRAIN_UNCONFIRMED', 'transaction proof does not override a live command group');
system(['/bin/busybox', 'kill', '-9', '-' + group], 100); child.close();
check(second.acquire_recovery(recovery_owner).ok && second.release(), 'only observed command disappearance authorizes immediate recovery');
mkdir(marker, 0700); writefile(marker + '/owner', 'not-a-pid\n');
check(second.acquire('manual-recovery').reason == 'ACTION_OWNER_UNKNOWN', 'unknown external ownership fails closed');
check(readfile(marker + '/owner') == 'not-a-pid\n', 'unknown ownership is not silently rewritten');
unlink(marker + '/owner');
print(sprintf('action-lock: %d assertions PASS\n', count));
