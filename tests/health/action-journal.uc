import { mkdtemp, readfile, writefile, chmod, unlink, symlink } from 'fs';
import { create_action_journal } from '../../luci-app-netbird/root/usr/share/netbird/health/action-journal.uc';
let dir = mkdtemp('/tmp/nbh-journal.XXXXXX'), now = 10000, n = 0;
let boot = '11111111-1111-1111-1111-111111111111';
function check(v, label) { if (!v) die('FAIL: ' + label + '\n'); n++; }
function id(value) { return sprintf('%032x', value); }
let journal = create_action_journal(dir, () => now, boot);
check(journal.reserve(id(1), 'manual-recovery', 'root', 'restart').ok, 'initial reservation');
let stored = json(readfile(dir + '/journal.json'));
check(stored.events[0].phase == 'reserved' && stored.events[0].actor == 'root', 'audit precedes command');
check(journal.reserve(id(1), 'manual-recovery', 'root', 'restart').reason == 'ACTION_ALREADY_RESERVED', 'same job never charged or invoked again');
check(journal.finish(id(1), {ok:false,reason:'COMMAND_FAILED',exit_code:9,invoked:true,cleanup_confirmed:true,stdout:'do not retain'}).ok, 'failed command can finish audit');
check(index(readfile(dir + '/journal.json'), 'do not retain') < 0, 'raw output omitted');
now += 59999;
check(journal.reserve(id(2), 'watchdog', 'local-root', 'restart').reason == 'ACTION_COOLDOWN', 'failed action still cooled');
now++;
check(journal.reserve(id(2), 'watchdog', 'local-root', 'restart').ok, 'cooldown exact boundary');
check(journal.finish(id(2), {ok:true,reason:null,exit_code:0,invoked:true,cleanup_confirmed:true}).ok, 'native null success reason supported');
let first = json(readfile(dir + '/journal.json')).events[1];
check(first.outcome == 'UNKNOWN' && first.phase == 'command_finished', 'command success is not health success');
now += 60000;
check(journal.reserve(id(3), 'manual-recovery', 'root', 'restart').ok, 'third reservation');
now += 60000;
check(journal.reserve(id(4), 'manual-recovery', 'root', 'restart').reason == 'ACTION_BUDGET_EXHAUSTED', 'fourth charged attempt blocked including unfinished prior action');
let restart = create_action_journal(dir, () => now, boot);
check(restart.reserve(id(4), 'manual-recovery', 'root', 'restart').reason == 'ACTION_BUDGET_EXHAUSTED', 'process restart does not reset budget');
now = 1;
check(restart.reserve(id(4), 'manual-recovery', 'root', 'restart').reason == 'ACTION_CLOCK_REVERSED', 'backwards monotonic time rejected');
let reboot = create_action_journal(dir, () => now, '22222222-2222-2222-2222-222222222222');
check(reboot.reserve(id(4), 'manual-recovery', 'root', 'restart').reason == 'ACTION_COOLDOWN', 'new boot conservatively reanchors attempts');
now += 60000;
check(reboot.reserve(id(4), 'manual-recovery', 'root', 'restart').reason == 'ACTION_BUDGET_EXHAUSTED', 'new boot does not mint budget');
now = 3600001;
check(reboot.reserve(id(4), 'manual-recovery', 'root', 'restart').ok, 'hour exact boundary frees budget without sliding reset');
check(reboot.finish(id(4), {ok:true,reason:'untrusted output',exit_code:0,invoked:true,cleanup_confirmed:true}).reason == 'ACTION_ARGUMENT_INVALID', 'arbitrary diagnostic prose rejected');
writefile(dir + '/journal.json', '{}');
check(reboot.reserve(id(5), 'manual-recovery', 'root', 'restart').reason == 'ACTION_JOURNAL_INVALID', 'corrupt storage is not reset');
unlink(dir + '/journal.json');
symlink('/etc/passwd', dir + '/journal.json');
check(reboot.reserve(id(5), 'manual-recovery', 'root', 'restart').reason == 'ACTION_JOURNAL_INVALID', 'symlink storage not adopted');
let config = create_action_journal(mkdtemp('/tmp/nbh-config-budget.XXXXXX'), () => now, boot);
for (let i = 101; i <= 104; i++) check(config.reserve(id(i), 'settings', 'local-root', 'settings').ok, 'explicit settings not blocked by recovery limit');
check(config.reserve(id(105), 'manual-recovery', 'root', 'restart').reason == 'ACTION_COOLDOWN', 'settings still cool subsequent recovery');
now += 60000;
check(config.reserve(id(105), 'manual-recovery', 'root', 'restart').reason == 'ACTION_BUDGET_EXHAUSTED', 'settings still consume recovery budget');
check(config.reserve(id(106), 'user-stop', 'root', 'control').ok, 'stop remains allowed with exhausted recovery budget');
check(config.finish_operation(id(106), 'handler_ok').ok, 'control handler can finish honestly');
check(config.finish_operation(id(106), 'handler_ok').reason == 'ACTION_ALREADY_FINISHED', 'handler acknowledgement cannot finish twice');
check(config.finish_operation(id(107), 'arbitrary prose').reason == 'ACTION_ARGUMENT_INVALID', 'handler audit admits only fixed outcomes');
let controls_dir = mkdtemp('/tmp/nbh-controls.XXXXXX');
let controls = create_action_journal(controls_dir, () => now, boot);
check(controls.reserve(id(201), 'user-stop', 'root', 'control').ok, 'stop starts without a recovery charge');
check(controls.finish_operation(id(201), 'handler_ok').ok, 'successful stop audit completes');
let control_event = json(readfile(controls_dir + '/journal.json')).events[0];
check(control_event.outcome == 'UNKNOWN' && control_event.command == null && control_event.operation.outcome == 'handler_ok', 'handler success never invents command or health success');
check(controls.reserve(id(202), 'watchdog', 'local-root', 'lifecycle').ok, 'non-recovery control neither consumes quota nor starts cooldown');
check(controls.finish_operation(id(202), 'handler_failed').ok, 'failed lifecycle handler audit completes');
check(controls.reserve(id(203), 'manual-recovery', 'root', 'restart').reason == 'ACTION_COOLDOWN', 'failed lifecycle action cools manual recovery');
print(sprintf('action journal: %d assertions PASS\n', n));
