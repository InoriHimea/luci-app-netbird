#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=96
STOP=9
USE_PROCD=1

start_service() {
    # Only the independent diagnostic configuration controls this service.
    /usr/bin/ucode -e 'import { read_config } from "/usr/share/netbird/health/settings.uc"; exit(read_config()?.monitor?.enabled === true ? 0 : 1);' || return 0
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/share/netbird/health/service.uc
    procd_set_param respawn 3600 21 0
    procd_set_param term_timeout 22
    procd_set_param file /etc/config/netbird_health
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger netbird_health
}
