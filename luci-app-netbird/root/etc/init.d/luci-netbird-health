#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=96
STOP=9
USE_PROCD=1

start_service() {
    # No configuration is an intentional disabled state. Configuration saving
    # never invokes this service or changes the NetBird connection intent.
    [ -f /etc/netbird-health/config.json ] || return 0
    /usr/bin/ucode -e 'import { read_json } from "/usr/share/netbird/health/storage.uc"; exit(read_json("/etc/netbird-health/config.json", 65536)?.monitor?.enabled === true ? 0 : 1);' || return 0
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/share/netbird/health/service.uc
    procd_set_param respawn 3600 21 0
    procd_set_param term_timeout 22
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
